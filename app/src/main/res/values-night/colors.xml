<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 2 Material 3 palette (FRM-42), dark theme counterpart to
  values/colors.xml - Designer's Confluence "Phase 2 UI Specs" §1.
  The avatar fallback palette itself isn't duplicated here: its dark-mode
  lightness shift is computed at runtime by AvatarPalette.kt ("compute at
  build time, don't hardcode" per the Designer spec), not stored as
  resources.
-->
<resources>
    <color name="fm_primary">#4DB6AC</color>
    <color name="fm_secondary">#F4A94E</color>
    <color name="fm_status_healthy">#81C784</color>
    <color name="fm_status_attention">#E0B84D</color>
    <color name="fm_status_neglected">#EF9A9A</color>
    <color name="fm_status_new">#BDBDBD</color>
</resources>
