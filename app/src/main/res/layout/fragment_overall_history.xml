<?xml version="1.0" encoding="utf-8"?>
<!--
  Overall History (OverallHistoryFragment, FRM-101, SCREENS-PHASE3.md §4).
  Replaces the temporary FRM-100 stub with real content, migrated from the
  now-deleted DashboardFragment: the key-metric block and the "Monthly
  outreach" chart move here re-skinned (§4.1/§4.5); "Your strongest
  connections" becomes "Longest streaks", reusing the Home contact row
  verbatim rather than the old horizontal chip strip (§4.6); "Needs
  attention" is retired (Home's per-row badge already covers it); the
  aggregated "Upcoming birthdays & dates" list is retired as a cross-contact
  view (FRM-105) - the per-contact Special Dates tab is unaffected.

  Structure: the same edge-to-edge teal header pattern as Home
  (statusBarSpacer + fixed 72dp title band, see OverallHistoryFragment's
  onResume/onPause), but with a back arrow -> Home (DESIGN-SYSTEM-PHASE3.md
  §5: "title then starts at 72dp" when a back arrow is present). Below the
  header, a single FrameLayout holds exactly one of: the loading indicator,
  the real content (one ScrollView - §4.8 is explicit that the streak list
  must be a static list inside it, not a nested-scrolling RecyclerView, to
  avoid repeating the Phase 2 GH #72/#76 nested-scroll bug), or the empty
  state - mirroring fragment_home.xml's own
  RecyclerView-vs-emptyStateGroup structure so there's exactly one proven
  pattern for "below-header content area" in this codebase.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/fm_header">

            <!-- Height set programmatically to the status-bar inset
                 (OverallHistoryFragment) - same fill as the title band
                 below, so the header reads as one uninterrupted block (§5). -->
            <View
                android:id="@+id/statusBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fm_home_header_height">

                <!-- §5: "white 26dp arrow at 24dp gutter" - 48dp touch
                     target via padding, drawable is 24dp so 12dp padding on
                     each side reaches it without inflating the drawn glyph. -->
                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/fm_on_primary"
                    android:contentDescription="@string/content_desc_back" />

                <!-- §4.3/§5: title starts at 72dp when a back arrow is present. -->
                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="@dimen/fm_space_6"
                    android:text="@string/title_overall_history"
                    android:textColor="@color/fm_on_primary"
                    android:textSize="@dimen/fm_header_title_size"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/contentScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/fm_space_8">

                    <!-- FRM-171 (OH-2): no horizontal padding on this column.
                         The streak rows reuse item_home_contact, which carries
                         its own 24dp gutter, so padding here inset them twice
                         (avatar at x=126 instead of Home's 63). The 24dp gutter
                         moves onto the non-row children below instead. -->

                    <!-- §4.4: the one fm_surface_accent block this screen is
                         allowed. Figure and label are two separate views
                         (never string concatenation - a quantity string
                         supplies the label), with a single contentDescription
                         set on the whole block in code so TalkBack reads one
                         statement rather than "48" then a label. -->
                    <LinearLayout
                        android:id="@+id/keyMetricBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fm_gutter"
                        android:layout_marginEnd="@dimen/fm_gutter"
                        android:layout_marginTop="@dimen/fm_space_8"
                        android:orientation="vertical"
                        android:background="@drawable/bg_key_metric_accent"
                        android:padding="@dimen/fm_space_6"
                        android:focusable="true"
                        android:importantForAccessibility="yes">

                        <!-- §3 Typography: the one place in Phase 3 where
                             type exceeds 30sp (48sp/56sp, weight 500 - no
                             exact system weight-500 alias exists besides the
                             sans-serif-medium font family, which is
                             system-supplied like the rest of Roboto, so no
                             new font dependency). -->
                        <TextView
                            android:id="@+id/keyMetricFigure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="48sp"
                            android:textColor="@color/fm_heading"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/keyMetricLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/fm_space_1"
                            android:textSize="16sp"
                            android:textColor="@color/fm_ink_dim"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <!-- §4.5: "Monthly outreach" - re-skinned BarChartView,
                         no card, directly on the surface. Bucket/scaling
                         logic and the persistent axis labels (GH #101/PR
                         #105) are unchanged - see BarChartView/
                         DashboardChartCalculator's kdocs. -->
                    <TextView
                        android:id="@+id/chartSectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fm_gutter"
                        android:layout_marginEnd="@dimen/fm_gutter"
                        android:layout_marginTop="@dimen/fm_space_8"
                        android:text="@string/label_overall_history_chart_header"
                        android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

                    <com.example.friendminder.ui.dashboard.BarChartView
                        android:id="@+id/monthlyChart"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginStart="@dimen/fm_gutter"
                        android:layout_marginEnd="@dimen/fm_gutter"
                        android:layout_marginTop="@dimen/fm_space_2" />

                    <!-- §4.6: "Longest streaks" - identical Home contact
                         rows (reused verbatim, not a new component), a
                         static list (not a RecyclerView - §4.8), whole
                         section (label included) hidden when no contact has
                         a streak. -->
                    <LinearLayout
                        android:id="@+id/streaksSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fm_space_8"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fm_gutter"
                            android:layout_marginEnd="@dimen/fm_gutter"
                            android:text="@string/label_overall_history_streaks_header"
                            android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

                        <LinearLayout
                            android:id="@+id/streaksContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/fm_space_2"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- §4.7: "no button" - explicit deviation from the general
                 empty-state pattern (§6.7), because the only resolving
                 action lives on Home and the header's back arrow already
                 goes there. -->
            <LinearLayout
                android:id="@+id/emptyStateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="@dimen/fm_space_8"
                android:paddingEnd="@dimen/fm_space_8"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_nav_history_outline"
                    android:alpha="0.4"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fm_space_8"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="22sp"
                    android:textColor="@color/fm_heading"
                    android:gravity="center"
                    android:text="@string/label_overall_history_empty_headline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fm_space_2"
                    android:textSize="16sp"
                    android:textColor="@color/fm_ink_dim"
                    android:gravity="center"
                    android:text="@string/label_overall_history_empty_body" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
