<?xml version="1.0" encoding="utf-8"?>
<!--
  Body shared by AddContactToGroupDialogFragment and
  EditContactGroupsDialogFragment. FRM-174 (DL-2): both are on
  FmBottomSheet now, so the handle, title, gutter and the single primary
  come from sheet_fm_base.xml; this is only the optional "+ New group"
  action, the empty text and the fixed-height candidate list.

  GH #72 / GH #76: the list is a fixed-height NestedScrollView. Neither
  ScrollView class honours maxHeight, and a plain ScrollView does not
  negotiate nested scrolling with BottomSheetBehavior (swipes collapsed the
  sheet instead of scrolling the list).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Button
        android:id="@+id/createGroupButton"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:minHeight="48dp"
        android:layout_marginBottom="@dimen/fm_space_2"
        app:icon="@drawable/ic_add"
        android:text="@string/action_new_group" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_add_to_group_empty"
        android:textAppearance="@style/TextAppearance.FM.RowPrimary"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/candidateScroll"
        android:layout_width="match_parent"
        android:layout_height="360dp">

        <LinearLayout
            android:id="@+id/candidateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
