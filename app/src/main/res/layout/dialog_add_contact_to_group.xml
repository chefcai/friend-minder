<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/fm_space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/fm_space_4">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_add_contact_to_group"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel" />
    </LinearLayout>

    <Button
        android:id="@+id/createGroupButton"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="@dimen/fm_space_2"
        app:icon="@drawable/ic_add"
        android:text="@string/action_new_group" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_add_to_group_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

    <!--
      GH #72 / GH #76: this was a plain android.widget.ScrollView. Two
      unrelated framework gaps in that class combined to make this dialog
      unusable with a realistic (40+) contact list, both confirmed
      on-device with a 45-contact candidate list:

      1. Neither android.widget.ScrollView NOR androidx.core.widget.
         NestedScrollView honors android:maxHeight - the attribute is
         silently ignored by both (this was verified empirically after an
         earlier attempt at this fix assumed NestedScrollView supported it
         and it measured 507dp tall instead of the intended 360dp cap), so
         the list grew to its full wrap_content height (one row per
         candidate) instead of capping. That pushed the Cancel/Save row
         (below, in this same LinearLayout) far past the bottom of the
         screen, with no scroll path to reach it, because the *outer*
         LinearLayout is not itself scrollable - only this inner element
         was. Fixed here with a genuine fixed height instead of a
         maxHeight that neither ScrollView class actually applies. This
         does mean a very short candidate list leaves some empty space
         below it rather than shrinking to fit - an acceptable trade-off
         against the footer being completely unreachable.

      2. Plain ScrollView does not implement NestedScrollingChild, so it
         never negotiates scroll ownership with the enclosing
         BottomSheetBehavior. Every swipe over the list was consumed by the
         sheet's own expand/collapse drag instead of by the list, so once
         scrolled down there was no gesture left to scroll back up - the
         same swipe that should scroll the list just collapsed the sheet.
         androidx.core.widget.NestedScrollView fixes this by implementing
         NestedScrollingChild, so BottomSheetBehavior lets it scroll
         internally before taking over the drag.
    -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp">

        <LinearLayout
            android:id="@+id/candidateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/fm_space_4">

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel" />

        <Button
            android:id="@+id/addButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fm_space_2"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
