<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/menu_contact_detail" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fm_space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/fm_space_4">

            <FrameLayout
                android:layout_width="@dimen/fm_avatar_size_detail"
                android:layout_height="@dimen/fm_avatar_size_detail"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/contactPhoto"
                    android:layout_width="@dimen/fm_avatar_size_detail"
                    android:layout_height="@dimen/fm_avatar_size_detail"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/contactInitial"
                    android:layout_width="@dimen/fm_avatar_size_detail"
                    android:layout_height="@dimen/fm_avatar_size_detail"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSecondaryContainer" />
            </FrameLayout>

            <TextView
                android:id="@+id/contactNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_2"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/birthdayFrequencyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_4"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/lastContactText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/streakText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/reachRateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_3"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                android:text="@string/label_groups_header"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_1" />

            <Button
                android:id="@+id/addGroupButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_add_group_chip" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_2"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyToggleButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/label_tab_history" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/specialDatesToggleButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/label_tab_special_dates" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/historyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/fm_space_8"
            android:text="@string/label_history_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/specialDatesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/fm_space_4">

                <TextView
                    android:id="@+id/specialDatesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/fm_space_4"
                    android:text="@string/label_special_dates_empty"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/specialDatesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/addSpecialDateButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/fm_space_4"
                    android:text="@string/action_add_special_date" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Friend-Minder cool rebrand (SCREENS-PHASE2.md §4): the primary
         outreach entry point is sky blue (secondary), not the default
         primary-fill Widget.Material3.Button style, so it's explicitly
         re-tinted here via the btn_secondary_background/btn_secondary_label
         color selectors rather than relying on the style default. -->
    <Button
        android:id="@+id/logOutreachButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="@dimen/fm_space_4"
        android:backgroundTint="@color/btn_secondary_background"
        android:textColor="@color/btn_secondary_label"
        android:text="@string/action_log_outreach" />
</LinearLayout>
