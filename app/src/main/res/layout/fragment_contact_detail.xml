<?xml version="1.0" encoding="utf-8"?>
<!--
    Contact Detail. FRM-158 (audit CD-1, Cai 2026-09-23) removed the GH #117
    Stop-tracking FAB: it sat inside "Add special date" and over the history
    timestamps, so part of an add button was a delete button. Stop tracking
    is now header overflow > "Stop tracking…" > confirmation sheet
    (SCREENS-PHASE3 Section 6.3). The root stays a FrameLayout; nothing
    floats over the page any more.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!--
        GH #132: extended teal header (DESIGN-SYSTEM-PHASE3.md §5), matching
        fragment_overall_history.xml's established pattern - see
        EdgeToEdgeHeader's kdoc. headerTitle has no static text: it's set to
        the contact's name in ContactDetailFragment.refresh(), same as the
        MaterialToolbar it replaces never had a static app:title either.
        GH #121 removed headerActionButton (the old toolbar's single
        menu_contact_detail.xml action, "edit frequency") - see the
        CHECK-IN FREQUENCY row below instead.
    -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fm_header">

        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_home_header_height">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/fm_on_primary"
                android:contentDescription="@string/content_desc_back" />

            <!-- GH #121 removed the frequency gear from this header.
                 FRM-158 (audit CD-1) adds the one header action this screen
                 has: an overflow menu holding "Stop tracking…". The title
                 reserves 72dp at the end for it, like Group Detail's edit
                 action. -->
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="72dp"
                android:textColor="@color/fm_on_primary"
                android:textSize="@dimen/fm_header_title_size"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/overflowButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/fm_on_primary"
                android:contentDescription="@string/content_desc_more_options" />
        </FrameLayout>
    </LinearLayout>

    <!-- FRM-157 (audit CD-2): the whole page below the header is ONE
         scroll container. It used to be a wrap_content ScrollView for the
         top block plus a separate 156dp scrolling strip for History (4 of
         5 rows visible, 1 at 200% text) and a third ScrollView for Special
         Dates. The history RecyclerView below is now a non-scrolling
         (nestedScrollingEnabled=false, wrap_content) list inside this
         NestedScrollView. The inner wrapper has no horizontal padding so
         the history rows keep their own 24dp gutter instead of doubling it. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/fm_space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/fm_gutter"
            android:paddingEnd="@dimen/fm_gutter"
            android:paddingTop="@dimen/fm_space_4"
            android:paddingBottom="@dimen/fm_space_4">

            <FrameLayout
                android:layout_width="@dimen/fm_avatar_size_detail"
                android:layout_height="@dimen/fm_avatar_size_detail"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/contactPhoto"
                    android:layout_width="@dimen/fm_avatar_size_detail"
                    android:layout_height="@dimen/fm_avatar_size_detail"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/contactInitial"
                    android:layout_width="@dimen/fm_avatar_size_detail"
                    android:layout_height="@dimen/fm_avatar_size_detail"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSecondaryContainer" />
            </FrameLayout>

            <TextView
                android:id="@+id/contactNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_2"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/birthdayFrequencyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- SCREENS-PHASE3.md Section 6.2 (GH #164/FRM-129): three
                 evenly-spaced figure stacks replace the old three sentence
                 lines (ContactStatistics.totalContacts / streak /
                 reachRate). "No boxes, no dividers - 32dp of air above and
                 below" is why the two colorOutlineVariant hairlines that
                 used to bracket the sentence block are gone too, replaced
                 by this row's own top/bottom margin (fm_space_8 = 32dp).
                 Each stack is one focusable node with a single
                 contentDescription set in code (bindStats) so TalkBack
                 reads one statement per figure rather than the numeral and
                 label separately - same pattern as Overall History's
                 keyMetricBlock (fragment_overall_history.xml). -->
            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_8"
                android:layout_marginBottom="@dimen/fm_space_8"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/outreachesStat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true"
                    android:importantForAccessibility="yes">

                    <TextView
                        android:id="@+id/outreachesFigure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="24sp"
                        android:textColor="@color/fm_heading"
                        android:gravity="center"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/Widget.FM.StatLabel"
                        android:layout_marginTop="@dimen/fm_space_1"
                        android:text="@string/label_stat_outreaches" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/streakStat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true"
                    android:importantForAccessibility="yes">

                    <TextView
                        android:id="@+id/streakFigure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="24sp"
                        android:textColor="@color/fm_heading"
                        android:gravity="center"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/Widget.FM.StatLabel"
                        android:layout_marginTop="@dimen/fm_space_1"
                        android:text="@string/label_stat_day_streak" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reachRateStat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:focusable="true"
                    android:importantForAccessibility="yes">

                    <TextView
                        android:id="@+id/reachRateFigure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="24sp"
                        android:textColor="@color/fm_heading"
                        android:gravity="center"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/Widget.FM.StatLabel"
                        android:layout_marginTop="@dimen/fm_space_1"
                        android:text="@string/label_stat_reach_rate" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                android:text="@string/label_groups_header"
                android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_1" />

            <Button
                android:id="@+id/addGroupButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_add_group_chip" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_2"
                android:background="?attr/colorOutlineVariant" />

            <!-- GH #121/SCREENS-PHASE3.md §6.2a: "CHECK-IN FREQUENCY section
                 label, then a single tappable row: the effective interval
                 and where it came from, with a trailing chevron." The row
                 shows only the value+source string (ContactDetailFragment.
                 bindFrequencyRow) - there's no separate static label inside
                 the row itself, since the section label above already says
                 what it is. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                android:text="@string/label_checkin_frequency_header"
                android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

            <LinearLayout
                android:id="@+id/checkInFrequencyRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/fm_space_1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_home_row_ripple"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/checkInFrequencyValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp"
                    android:textColor="@color/fm_ink" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_2"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyToggleButton"
                    style="@style/Widget.FM.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_tab_history" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/specialDatesToggleButton"
                    style="@style/Widget.FM.SegmentedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_tab_special_dates" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/historyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/fm_space_8"
            android:text="@string/label_history_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/specialDatesScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fm_gutter"
                android:paddingTop="@dimen/fm_space_4"
                android:paddingEnd="@dimen/fm_gutter"
                android:paddingBottom="@dimen/fm_space_4">

                <TextView
                    android:id="@+id/specialDatesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/fm_space_4"
                    android:text="@string/label_special_dates_empty"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/specialDatesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/addSpecialDateButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/fm_space_4"
                    android:text="@string/action_add_special_date" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</FrameLayout>
