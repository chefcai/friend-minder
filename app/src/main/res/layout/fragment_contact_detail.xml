<?xml version="1.0" encoding="utf-8"?>
<!--
    GH #117: root is a FrameLayout (was a plain vertical LinearLayout) so
    stopTrackingFab below can float over the screen's content in the same
    bottom-right spot as Home's addContactFab - add and remove now live in
    the same position on their respective screens, per Cai's direction on
    #117. This is also what freed up the corner: the old pinned
    logOutreachButton that used to occupy the bottom of this screen is
    gone - manual outreach logging (FRM-114) was pulled from this build
    (Cai, 2026-09-21) rather than merely demoted, which is what resolved
    #117's original FAB/pinned-button placement conflict.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!--
        GH #132: extended teal header (DESIGN-SYSTEM-PHASE3.md §5), matching
        fragment_overall_history.xml's established pattern - see
        EdgeToEdgeHeader's kdoc. headerTitle has no static text: it's set to
        the contact's name in ContactDetailFragment.refresh(), same as the
        MaterialToolbar it replaces never had a static app:title either.
        GH #121 removed headerActionButton (the old toolbar's single
        menu_contact_detail.xml action, "edit frequency") - see the
        CHECK-IN FREQUENCY row below instead.
    -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fm_header">

        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_home_header_height">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/fm_on_primary"
                android:contentDescription="@string/content_desc_back" />

            <!-- GH #121/SCREENS-PHASE3.md §6.2: "No header action at all -
                 the gear ('Reminder Frequency') is removed, and frequency
                 becomes a tappable row in the body." headerTitle's end
                 margin follows the no-action-button convention already
                 used by fragment_overall_history.xml/fragment_settings.xml
                 rather than reserving space for a button that no longer
                 exists here. -->
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="@dimen/fm_space_6"
                android:textColor="@color/fm_on_primary"
                android:textSize="@dimen/fm_header_title_size"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fm_space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/fm_gutter"
            android:paddingEnd="@dimen/fm_gutter"
            android:paddingTop="@dimen/fm_space_4"
            android:paddingBottom="@dimen/fm_space_4">

            <FrameLayout
                android:layout_width="@dimen/fm_avatar_size_detail"
                android:layout_height="@dimen/fm_avatar_size_detail"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/contactPhoto"
                    android:layout_width="@dimen/fm_avatar_size_detail"
                    android:layout_height="@dimen/fm_avatar_size_detail"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/contactInitial"
                    android:layout_width="@dimen/fm_avatar_size_detail"
                    android:layout_height="@dimen/fm_avatar_size_detail"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSecondaryContainer" />
            </FrameLayout>

            <TextView
                android:id="@+id/contactNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_2"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/birthdayFrequencyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_4"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/lastContactText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/streakText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/reachRateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_3"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                android:text="@string/label_groups_header"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_1" />

            <Button
                android:id="@+id/addGroupButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_add_group_chip" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_2"
                android:background="?attr/colorOutlineVariant" />

            <!-- GH #121/SCREENS-PHASE3.md §6.2a: "CHECK-IN FREQUENCY section
                 label, then a single tappable row: the effective interval
                 and where it came from, with a trailing chevron." The row
                 shows only the value+source string (ContactDetailFragment.
                 bindFrequencyRow) - there's no separate static label inside
                 the row itself, since the section label above already says
                 what it is. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                android:text="@string/label_checkin_frequency_header"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <LinearLayout
                android:id="@+id/checkInFrequencyRow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/fm_space_1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_home_row_ripple"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/checkInFrequencyValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp"
                    android:textColor="@color/fm_ink" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/fm_space_2"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_3"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/historyToggleButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/label_tab_history" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/specialDatesToggleButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/label_tab_special_dates" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/historyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/fm_space_8"
            android:text="@string/label_history_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/specialDatesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/fm_space_4">

                <TextView
                    android:id="@+id/specialDatesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/fm_space_4"
                    android:text="@string/label_special_dates_empty"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/specialDatesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/addSpecialDateButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/fm_space_4"
                    android:text="@string/action_add_special_date" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    </LinearLayout>

    <!-- GH #117 (SCREENS-PHASE3.md §6.3): destructive "Stop tracking" entry
         point, in the same bottom-right spot as Home's addContactFab
         (fm_space_6 end margin, fm_space_4 bottom margin) so add and
         remove share a position across their respective screens.
         contentDescription is set dynamically in refresh() once the
         contact's name is known - static "Stop tracking" alone isn't a
         sufficient a11y label for a destructive per-contact action. Styled
         like the bulk-removal FAB (FRM-112): fm_error fill, ic_trash,
         fm_on_primary tint - the one other destructive-styled control in
         the app. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/stopTrackingFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fm_space_6"
        android:layout_marginBottom="@dimen/fm_space_4"
        android:contentDescription="@string/action_stop_tracking"
        app:elevation="3dp"
        app:backgroundTint="@color/fm_error"
        app:tint="@color/fm_on_primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MaterialComponents.FloatingActionButton"
        app:srcCompat="@drawable/ic_trash" />
</FrameLayout>
