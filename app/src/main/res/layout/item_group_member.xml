<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/fm_gutter"
    android:paddingEnd="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/fm_avatar_size_list"
        android:layout_height="@dimen/fm_avatar_size_list">

        <ImageView
            android:id="@+id/contactPhoto"
            android:layout_width="@dimen/fm_avatar_size_list"
            android:layout_height="@dimen/fm_avatar_size_list"
            android:background="@drawable/bg_avatar_placeholder"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/contactInitial"
            android:layout_width="@dimen/fm_avatar_size_list"
            android:layout_height="@dimen/fm_avatar_size_list"
            android:background="@drawable/bg_avatar_placeholder"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </FrameLayout>

    <TextView
        android:id="@+id/memberName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <!-- FRM-167: hidden by default. Only MissingContactsDialogFragment,
         which reuses this row, turns it on; Group Detail removes members
         through selection mode instead (see selectionSlot below). -->
    <ImageButton
        android:id="@+id/removeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_remove_from_group"
        android:visibility="gone" />

    <!-- FRM-167 (GD-1): Group Detail has no per-row remove button. Members are
         removed through long-press selection mode (SCREENS Section 10,
         same as Home); this 28dp slot shows the selection ring/check only
         while that mode is on, reusing Home's badge-slot drawables. -->
    <FrameLayout
        android:id="@+id/selectionSlot"
        android:layout_width="@dimen/fm_status_badge_size"
        android:layout_height="@dimen/fm_status_badge_size"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/selectionCheck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="@color/fm_on_primary" />
    </FrameLayout>
</LinearLayout>
