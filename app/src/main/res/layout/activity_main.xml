<?xml version="1.0" encoding="utf-8"?>
<!--
  Navigation shell (FRM-100, SCREENS-PHASE3.md §2). Bottom nav is shared
  chrome across all four Phase 3 "shell" screens (Home, Groups, Overall
  History, Settings) - MainActivity shows/hides it and drives destination
  switching; individual fragments never touch it directly.

  nav_host_container gets layout_weight="1" (not match_parent under the
  bar) precisely so it never extends behind the bottom nav - this is what
  makes a plain 16dp FAB margin in fragment_home.xml actually mean "16dp
  above the bottom nav" rather than needing the nav bar's height baked in
  as a magic number there. bottomNavDivider is a real 1dp View rather than
  BottomNavigationView elevation, which DESIGN-SYSTEM-PHASE3.md §2.2
  explicitly sets to 0dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/nav_host_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_bottom_nav_divider"
        android:visibility="gone" />

    <!--
        FRM-115: layout_height here is the bar's un-eclipsed content height
        (SCREENS-PHASE3.md SS2.1) - MainActivity.applyBottomNavInsets grows
        the view by the real bottom system-bar inset and adds that inset
        back as bottom padding, so the fill extends behind the gesture bar
        while the items themselves stay within the top @dimen/fm_bottom_nav_height,
        matching statusBarSpacer's pattern in fragment_home.xml for the top
        inset. itemIconSize overrides the default M3 unlabeled-item 24dp
        icon up to the spec's 28dp. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fm_bottom_nav_height"
        android:background="@color/fm_surface"
        app:elevation="0dp"
        app:itemIconSize="@dimen/fm_bottom_nav_icon_size"
        app:itemIconTint="@null"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/menu_bottom_nav"
        android:visibility="gone" />

</LinearLayout>
