<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (root) - FRM-99, SCREENS-PHASE3.md §1. Replaces DashboardFragment as
  the app's root screen.

  Structure per §1.1: one continuous teal header (statusBarSpacer + a fixed
  72dp title band, so the fill spans the status bar with no seam - see
  HomeFragment.onResume/onPause for the edge-to-edge wiring that makes
  statusBarSpacer's height track the real inset), a flat contact list, and
  a FAB. The bottom nav itself lives in activity_main.xml, not here - it's
  shared chrome across all four Phase 3 shell screens (FRM-100), not part
  of any one fragment's layout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/fm_header">

            <!-- Height set programmatically to the status-bar inset
                 (HomeFragment) - same fill as the title band below, so the
                 header reads as one uninterrupted block (§5). -->
            <View
                android:id="@+id/statusBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fm_home_header_height">

                <!-- FRM-112 (§10.2/§10.3): hidden outside selection mode.
                     Same 48dp-touch-target-via-padding geometry as
                     fragment_overall_history.xml's backButton, white glyph,
                     borderless ripple - HomeFragment toggles visibility and
                     headerTitle's start margin together. -->
                <ImageButton
                    android:id="@+id/headerCloseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/fm_on_primary"
                    android:contentDescription="@string/content_desc_close_selection_mode"
                    android:visibility="gone" />

                <!-- §1.2: literal title "Friend-Minder", no back arrow (Home
                     is the root), no overflow menu - both of Dashboard's old
                     toolbar actions moved elsewhere (FAB, bottom nav).
                     FRM-112: HomeFragment swaps both the text and the start
                     margin (24dp normally, @dimen/fm_header_title_margin_with_leading_icon
                     when headerCloseButton is showing, §10.3) between this
                     and "N selected" while in selection mode. -->
                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/fm_space_6"
                    android:layout_marginEnd="@dimen/fm_space_6"
                    android:text="@string/title_home"
                    android:textColor="@color/fm_on_primary"
                    android:textSize="@dimen/fm_header_title_size"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contactRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/fm_home_list_bottom_padding"
                android:visibility="gone" />

            <!--
                Interim placeholder for zero tracked contacts. FRM-107 (the
                approved, designed empty state - 96dp glyph, headline, body
                copy, filled "Add someone" button) hasn't landed a sign-off
                yet (see FRM-99's ticket comment: "Build the populated list
                against this spec; the empty state lands when FRM-107 is
                acked"), so this is a plain, unstyled stand-in rather than a
                pre-emptive implementation of an unapproved design - swap
                this block for the real thing once FRM-107 is signed off.
            -->
            <LinearLayout
                android:id="@+id/emptyStateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/fm_space_8"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/label_home_empty_interim"
                    android:textColor="@color/fm_ink_dim"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:layout_marginBottom="@dimen/fm_space_6" />

                <Button
                    android:id="@+id/emptyStateAddButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_home_empty_add" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!--
        §1.7: FAB is the only add-contact entry point once there's at least
        one contact (hidden in the empty state - see HomeFragment). Tap
        target here opens the existing Edit Friends picker, not the
        rebuilt single-flow add process the approved spec describes -
        FRM-102 isn't implemented yet, so this is the closest working
        equivalent in the interim (flagged on FRM-99's ticket).
    -->
    <!--
        FRM-123: Material 3's default FAB style (?attr/floatingActionButtonStyle
        -> Widget.Material3.FloatingActionButton.Primary) sets its own
        shapeAppearance to the M3 "large component" token, a rounded
        square, not a circle - shapeAppearanceOverlay="@null" there also
        strips the plain MaterialComponents FAB style's circular 50%
        cornerSize it would otherwise inherit. SCREENS-PHASE3.md SS1.7 is
        explicit that the FAB's one visual justification for existing
        outside "nothing floats and nothing is boxed" is "it is a circle
        rather than a box", so this restores the pre-M3 circular shape
        (also fixes the mismatched-shadow "ghost" edge, which is the
        compat elevation shadow drawn for a circle underneath what had
        been a squircle foreground). -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addContactFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fm_space_6"
        android:layout_marginBottom="@dimen/fm_space_4"
        android:contentDescription="@string/content_desc_add_contact"
        app:elevation="3dp"
        app:backgroundTint="@color/fm_primary"
        app:tint="@color/fm_on_primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MaterialComponents.FloatingActionButton"
        app:srcCompat="@drawable/ic_add" />

</FrameLayout>
