<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_dashboard"
        app:menu="@menu/menu_dashboard" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/fm_space_8"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/emptyStateGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/fm_space_8"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_dashboard_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:gravity="center" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/contentGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/fm_space_4">

            <!-- Key metric card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/fm_card_corner_radius"
                app:cardElevation="@dimen/fm_card_elevation">

                <TextView
                    android:id="@+id/keyMetricText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/fm_card_padding"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Streaks card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/streaksCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_6"
                app:cardCornerRadius="@dimen/fm_card_corner_radius"
                app:cardElevation="@dimen/fm_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/fm_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_dashboard_streaks_header"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:layout_marginBottom="@dimen/fm_space_2" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/streaksContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Neglected card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/neglectedCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_6"
                app:cardCornerRadius="@dimen/fm_card_corner_radius"
                app:cardElevation="@dimen/fm_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/fm_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_dashboard_neglected_header"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="@dimen/fm_space_2" />

                    <LinearLayout
                        android:id="@+id/neglectedContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Monthly outreach chart card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_6"
                app:cardCornerRadius="@dimen/fm_card_corner_radius"
                app:cardElevation="@dimen/fm_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/fm_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_dashboard_chart_header"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:layout_marginBottom="@dimen/fm_space_2" />

                    <com.example.friendminder.ui.dashboard.BarChartView
                        android:id="@+id/monthlyChart"
                        android:layout_width="match_parent"
                        android:layout_height="96dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upcoming dates card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/upcomingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fm_space_6"
                app:cardCornerRadius="@dimen/fm_card_corner_radius"
                app:cardElevation="@dimen/fm_card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/fm_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_dashboard_upcoming_header"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:layout_marginBottom="@dimen/fm_space_2" />

                    <LinearLayout
                        android:id="@+id/upcomingContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
