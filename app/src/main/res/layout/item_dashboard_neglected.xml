<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/fm_space_2"
    android:paddingBottom="@dimen/fm_space_2"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="@dimen/fm_avatar_size_list"
        android:layout_height="@dimen/fm_avatar_size_list">

        <ImageView
            android:id="@+id/contactPhoto"
            android:layout_width="@dimen/fm_avatar_size_list"
            android:layout_height="@dimen/fm_avatar_size_list"
            android:background="@drawable/bg_avatar_placeholder"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/contactInitial"
            android:layout_width="@dimen/fm_avatar_size_list"
            android:layout_height="@dimen/fm_avatar_size_list"
            android:background="@drawable/bg_avatar_placeholder"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/fm_space_3"
        android:orientation="vertical">

        <TextView
            android:id="@+id/neglectedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/neglectedDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fm_status_attention"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>

    <Button
        android:id="@+id/reachOutButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_reach_out" />
</LinearLayout>
