<?xml version="1.0" encoding="utf-8"?>
<!--
  Home contact row (FRM-99, SCREENS-PHASE3.md §1.3/§1.5/§1.6).

  Layout across the row: 24dp gutter -> 48dp avatar -> 16dp -> flexible text
  block -> 12dp -> 28dp badge -> 24dp gutter. RelativeLayout, not
  ConstraintLayout - this project deliberately keeps its dependency tree
  minimal (see ServiceLocator's kdoc / build.gradle.kts) and nothing else
  in the app pulls in androidx.constraintlayout, so this uses the
  framework's own RelativeLayout instead of adding that dependency for one
  screen. avatarContainer and statusBadge are both fixed-size and
  edge-anchored; textBlock is constrained toEndOf/toStartOf both of them,
  so it's the element that yields on a long name (§1.6) - the badge is
  never at risk of being pushed off-screen regardless of XML order,
  because RelativeLayout resolves siblings by id, not by document order.

  topDivider is a real 1dp hairline on every row; HomeContactAdapter hides
  it for position 0 so there's no divider above the first row or (since
  it's a *top* divider) after the last one - see that class.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeContactRow"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fm_home_row_height"
    android:background="@drawable/bg_home_row_ripple"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/fm_space_6"
        android:layout_marginEnd="@dimen/fm_space_6"
        android:background="@color/fm_divider" />

    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="@dimen/fm_avatar_size_list"
        android:layout_height="@dimen/fm_avatar_size_list"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/fm_space_6">

        <ImageView
            android:id="@+id/contactPhoto"
            android:layout_width="@dimen/fm_avatar_size_list"
            android:layout_height="@dimen/fm_avatar_size_list"
            android:background="@drawable/bg_avatar_placeholder"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/contactInitial"
            android:layout_width="@dimen/fm_avatar_size_list"
            android:layout_height="@dimen/fm_avatar_size_list"
            android:background="@drawable/bg_avatar_placeholder"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/statusBadge"
        android:layout_width="@dimen/fm_status_badge_size"
        android:layout_height="@dimen/fm_status_badge_size"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/fm_space_6">

        <TextView
            android:id="@+id/statusBadgeNumeral"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/fm_on_primary"
            android:importantForAccessibility="no" />

        <!-- FRM-112 (§10.3): selection mode swaps this same 28dp slot from
             the streak numeral above to this check glyph - nothing moves,
             nothing resizes, same bg_status_badge_ring/filled ring/fill the
             numeral already uses. Verbatim reuse of
             item_add_contact_candidate.xml's selectionCheck (see that
             file), just living inside statusBadge instead of a second
             FrameLayout, since this is the same visual slot wearing two
             hats rather than a separate control. -->
        <ImageView
            android:id="@+id/selectionCheck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            app:tint="@color/fm_on_primary"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/textBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/avatarContainer"
        android:layout_toStartOf="@id/statusBadge"
        android:layout_marginStart="@dimen/fm_space_4"
        android:layout_marginEnd="@dimen/fm_space_3">

        <TextView
            android:id="@+id/contactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp"
            android:textColor="@color/fm_ink" />

        <TextView
            android:id="@+id/lastTouch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/fm_ink_dim" />
    </LinearLayout>

</RelativeLayout>
