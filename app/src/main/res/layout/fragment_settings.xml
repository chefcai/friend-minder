<?xml version="1.0" encoding="utf-8"?>
<!--
    FRM-130: root is a FrameLayout so the auto-save "Saved" pill
    (settingsSavedPill below) can overlay the screen without shifting any
    other content - a LinearLayout sibling would push things down/up each
    time the pill's visibility changes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            GH #132: extended teal header (DESIGN-SYSTEM-PHASE3.md §5),
            matching fragment_overall_history.xml's established pattern -
            see EdgeToEdgeHeader's kdoc. Settings has no menu action, so
            this is the header-only-with-back-arrow shape (same as
            fragment_advanced_settings.xml / fragment_legacy_diagnostics.xml).
        -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/fm_header">

            <View
                android:id="@+id/statusBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fm_home_header_height">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/fm_on_primary"
                    android:contentDescription="@string/content_desc_back" />

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="@dimen/fm_space_6"
                    android:text="@string/title_settings"
                    android:textColor="@color/fm_on_primary"
                    android:textSize="@dimen/fm_header_title_size"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Reminder Time -->
                <TextView
                    style="?attr/textAppearanceTitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/label_reminder_time" />

                <RadioGroup
                    android:id="@+id/timeModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/fixedTimeRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/option_fixed_time"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/randomWindowRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/option_random_window" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/fixedTimeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_time" />

                    <Button
                        android:id="@+id/fixedTimeButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/randomWindowGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_from" />

                        <Button
                            android:id="@+id/randomFromButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_to" />

                        <Button
                            android:id="@+id/randomToButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/timeRangeErrorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/error_end_before_start"
                    android:textColor="?attr/colorError"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />

                <!-- Contacts Per Day -->
                <TextView
                    style="?attr/textAppearanceTitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="24dp"
                    android:text="@string/label_contacts_per_day" />

                <Spinner
                    android:id="@+id/contactsPerDaySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/helper_contacts_per_day"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <!-- Cooldown Period - GH #98/#121: migrated off Spinner to
                     the shared ValuePickerDialogFragment (SCREENS-PHASE3.md
                     §7.2/§8.4: "the global cooldown ... are the same
                     control asking the same question"), so it gets the
                     Custom... entry path for free instead of needing a
                     fourth bespoke one. Matches item_group.xml's / this
                     screen's own advancedRow's row-with-chevron shape
                     rather than introducing a third row style. -->
                <TextView
                    style="?attr/textAppearanceTitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="24dp"
                    android:text="@string/label_cooldown" />

                <LinearLayout
                    android:id="@+id/cooldownRow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_row_ripple"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/cooldownValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="17sp"
                        android:textColor="@color/fm_ink" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- Message Templates (chefcai/friend-minder#30: multiple, randomly picked) -->
                <TextView
                    style="?attr/textAppearanceTitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="24dp"
                    android:text="@string/label_message_templates" />

                <CheckBox
                    android:id="@+id/includeMessageCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="@string/checkbox_include_message" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_message_templates">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/messageTemplateInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="4"
                        android:maxLines="8" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/charCounterText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

            </LinearLayout>
        </ScrollView>

        <!--
            FRM-130: there is no "Save Settings" button (SCREENS-PHASE3 §7.2)
            - every control above writes to SettingsRepository on change,
            debounced (SettingsFragment.scheduleAutoSave), confirmed by
            settingsSavedPill rather than a Toast. This also resolves GH
            #130's occlusion report outright: the removed button was the
            only thing ever overlapping the message-templates field.
        -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fm_divider" />

        <!--
            FRM-131: rows with a trailing chevron (SCREENS-PHASE3 §7.2: "a
            normal row with a chevron in its own section, not a bare text
            link floating at the bottom"), matching item_group.xml's
            established row pattern. Previously plain TextViews styled as
            bold links in fm_status_healthy - an orphaned Phase 2 status
            color, not a brand token (see colors.xml) - which is why they
            read as stock-Android link blue instead of brand teal.
        -->
        <LinearLayout
            android:id="@+id/advancedRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:text="@string/title_advanced_settings" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fm_divider" />

        <!--
            FRM-99: interim home for the retired setup-hub's banners/test-
            notification content (see LegacyDiagnosticsFragment's kdoc) - not
            a Designer-P3 spec, just wired here so the functionality stays
            reachable pending the FRM-103 pass that's meant to design its
            real home. Mirrors advancedRow's row pattern above rather than
            introducing a new row convention.
        -->
        <LinearLayout
            android:id="@+id/notificationsDiagnosticsRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:text="@string/title_notifications_diagnostics" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />
        </LinearLayout>

    </LinearLayout>

    <!--
        FRM-130 (SCREENS-PHASE3 §7.4, decided by Cai 2026-09-21): transient
        auto-save confirmation. Overlaid via this FrameLayout rather than
        stacked in the LinearLayout above so it never shifts other content
        when it fades in/out (SettingsFragment.showSavedPill).
    -->
    <LinearLayout
        android:id="@+id/settingsSavedPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_pill_saved"
        android:elevation="4dp"
        android:visibility="invisible"
        android:focusable="false"
        android:clickable="false"
        android:accessibilityLiveRegion="polite">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_small"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@android:color/white"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:text="@string/label_settings_saved_pill" />
    </LinearLayout>

</FrameLayout>
