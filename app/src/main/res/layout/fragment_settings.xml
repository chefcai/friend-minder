<?xml version="1.0" encoding="utf-8"?>
<!--
    FRM-130: root is a FrameLayout so the auto-save "Saved" pill
    (settingsSavedPill below) can overlay the screen without shifting any
    other content - a LinearLayout sibling would push things down/up each
    time the pill's visibility changes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            GH #132: extended teal header (DESIGN-SYSTEM-PHASE3.md §5),
            matching fragment_overall_history.xml's established pattern -
            see EdgeToEdgeHeader's kdoc. Settings has no menu action, so
            this is the header-only-with-back-arrow shape (same as
            fragment_advanced_settings.xml / fragment_legacy_diagnostics.xml).
        -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/fm_header">

            <View
                android:id="@+id/statusBarSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/fm_home_header_height">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/fm_on_primary"
                    android:contentDescription="@string/content_desc_back" />

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="72dp"
                    android:layout_marginEnd="@dimen/fm_space_6"
                    android:text="@string/title_settings"
                    android:textColor="@color/fm_on_primary"
                    android:textSize="@dimen/fm_header_title_size"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>
        </LinearLayout>

        <!-- GH #153: id + clipToPadding=false so ImeInsetPadding
             (SettingsFragment.onViewCreated) can grow this view's bottom
             padding by the keyboard's inset - clipToPadding=false lets the
             scrollable content actually use that extra space to scroll a
             focused field clear of the keyboard, instead of the padding
             just clipping off the bottom of what's drawn. -->
        <ScrollView
            android:id="@+id/settingsScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fm_gutter"
                android:paddingEnd="@dimen/fm_gutter"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Reminder Time -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_reminder_time"
                    android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

                <!-- GH #165/FRM-130: segmented control replacing the radio
                     pair (SCREENS-PHASE3.md Section 7.2), matching Contact
                     Detail's tabToggleGroup (fragment_contact_detail.xml)
                     rather than introducing a second segmented-control
                     shape. -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/timeModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fixedTimeToggleButton"
                        style="@style/Widget.FM.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/option_fixed_time" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/randomWindowToggleButton"
                        style="@style/Widget.FM.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/option_random_window" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- FRM-166 (ST-4): the reminder time is a value row like every
                     other setting with a value (label left, value and chevron
                     right, minHeight 64dp) instead of outlined pill buttons.
                     Fixed time: "Time  5:00 AM >". Random window: "Window
                     8:00 AM - 12:00 PM >", which opens the start picker and then
                     the end picker. -->
                <LinearLayout
                    android:id="@+id/timeRow"
                    style="@style/Widget.FM.ValueRow"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/timeLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_time"
                            android:textAppearance="@style/TextAppearance.FM.RowPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/timeValue"
                        style="@style/Widget.FM.ValueRow.Value" />

                    <ImageView
                        style="@style/Widget.FM.ValueRow.Chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- FRM-164 (ST-1): the next-reminder notice is now Row
                     Secondary in fm_ink_dim with a leading clock icon; only
                     the invalid-range error (something the user has to fix)
                     switches it to fm_error with no icon. See
                     SettingsFragment.validateTimeRange.
                     GH #150 follow-up: a single shared status line, originally
                     styled like a validation error (colorError), so the
                     "invalid range" error and the "next reminder lands
                     today/tomorrow" notice can never both be on screen or
                     visually collide - there's only one view, and its text
                     is swapped depending on validation state. Not a true
                     error in the notice case, but it still wants the same
                     visual weight/attention as one. -->
                <TextView
                    android:id="@+id/timeStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/error_end_before_start"
                    android:textAppearance="@style/TextAppearance.FM.RowSecondary" />

                <!-- FRM-165 (ST-2): REMINDERS section. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/label_section_reminders"
                    android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

                <!-- GH #165/FRM-130 + #98/#121: both open the shared
                     ValuePickerDialogFragment. FRM-166 (ST-4): now in the one
                     value-row shape (label and helper left, value and chevron
                     right) instead of a heading above a separate value row. -->
                <LinearLayout
                    android:id="@+id/contactsPerDayRow"
                    style="@style/Widget.FM.ValueRow"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_contacts_per_day"
                            android:textAppearance="@style/TextAppearance.FM.RowPrimary" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/helper_contacts_per_day"
                            android:textAppearance="@style/TextAppearance.FM.RowSecondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/contactsPerDayValue"
                        style="@style/Widget.FM.ValueRow.Value" />

                    <ImageView
                        style="@style/Widget.FM.ValueRow.Chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cooldownRow"
                    style="@style/Widget.FM.ValueRow"
                    android:layout_marginTop="0dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_cooldown"
                            android:textAppearance="@style/TextAppearance.FM.RowPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/cooldownValue"
                        style="@style/Widget.FM.ValueRow.Value" />

                    <ImageView
                        style="@style/Widget.FM.ValueRow.Chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- FRM-165 (ST-2): MESSAGES section - the switch plus a Templates value
                     row that opens TemplatesEditorSheet (chefcai/friend-minder#30:
                     multiple templates, one picked at random). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/label_section_messages"
                    android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

                <!-- FRM-122 (FRM-103 §7.1 cross-cutting decision 3,
                     "Switches, not checkboxes"): a settings boolean is a
                     switch idiom, not a form-selection CheckBox - label at
                     Row Primary, switch trailing, full-row touch target
                     instead of the CheckBox's small one. No separate
                     description applies to this one (unlike Advanced's two
                     rows below), so it's label-only. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/fm_space_4"
                        android:text="@string/checkbox_include_message"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/includeMessageSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/templatesRow"
                    style="@style/Widget.FM.ValueRow"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_templates_row"
                            android:textAppearance="@style/TextAppearance.FM.RowPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/templatesValue"
                        style="@style/Widget.FM.ValueRow.Value" />

                    <ImageView
                        style="@style/Widget.FM.ValueRow.Chevron"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- FRM-165 (ST-2): MORE section. Notifications and Advanced
                     used to be pinned below the scroll area (outside it),
                     eating ~300px of every screen and unreachable-by-scroll
                     at large text sizes; they now scroll with everything else.
                     Same row shape as the value rows above (no inner gutter:
                     the scroll content already carries the 24dp gutter). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/label_section_more"
                    android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

                <LinearLayout
                    android:id="@+id/notificationsDiagnosticsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_row_ripple"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_notifications_diagnostics"
                        android:textAppearance="@style/TextAppearance.FM.RowPrimary" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advancedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_home_row_ripple"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_advanced_settings"
                        android:textAppearance="@style/TextAppearance.FM.RowPrimary" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!--
        FRM-130 (SCREENS-PHASE3 §7.4, decided by Cai 2026-09-21): transient
        auto-save confirmation. Overlaid via this FrameLayout rather than
        stacked in the LinearLayout above so it never shifts other content
        when it fades in/out (SettingsFragment.showSavedPill).
    -->
    <LinearLayout
        android:id="@+id/settingsSavedPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_pill_saved"
        android:elevation="4dp"
        android:visibility="invisible"
        android:focusable="false"
        android:clickable="false"
        android:accessibilityLiveRegion="polite">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_small"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@android:color/white"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:text="@string/label_settings_saved_pill" />
    </LinearLayout>

</FrameLayout>
