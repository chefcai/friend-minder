<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIconTint="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Reminder Time -->
            <TextView
                style="?attr/textAppearanceTitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/label_reminder_time" />

            <RadioGroup
                android:id="@+id/timeModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/fixedTimeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/option_fixed_time"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/randomWindowRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/option_random_window" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/fixedTimeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_time" />

                <Button
                    android:id="@+id/fixedTimeButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/randomWindowGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_from" />

                    <Button
                        android:id="@+id/randomFromButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_to" />

                    <Button
                        android:id="@+id/randomToButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/timeRangeErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/error_end_before_start"
                android:textColor="?attr/colorError"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />

            <!-- Contacts Per Day -->
            <TextView
                style="?attr/textAppearanceTitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="24dp"
                android:text="@string/label_contacts_per_day" />

            <Spinner
                android:id="@+id/contactsPerDaySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/helper_contacts_per_day"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <!-- Cooldown Period -->
            <TextView
                style="?attr/textAppearanceTitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="24dp"
                android:text="@string/label_cooldown" />

            <Spinner
                android:id="@+id/cooldownSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Message Templates (chefcai/friend-minder#30: multiple, randomly picked) -->
            <TextView
                style="?attr/textAppearanceTitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="24dp"
                android:text="@string/label_message_templates" />

            <CheckBox
                android:id="@+id/includeMessageCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/checkbox_include_message" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_message_templates">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/messageTemplateInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:maxLines="8" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/charCounterText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodySmall" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/saveSettingsButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/action_save_settings" />

    <!--
        FRM-79 (GH #90): Advanced moved here from being a direct toolbar
        shortcut. No icon/chevron - this screen has no chevron convention to
        match (unlike HomeFragment's navigation rows). Color + bold weight
        are the only visual cues that this is a link, so accessibilityHeading
        is deliberately not used; TalkBack's announcement that this opens a
        new screen instead comes from SettingsFragment setting an
        AccessibilityDelegate that reports ClassName.BUTTON (see
        SettingsFragment.onViewCreated).
    -->
    <TextView
        android:id="@+id/advancedRow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/fm_status_healthy"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:text="@string/title_advanced_settings" />

    <!--
        FRM-99: interim home for the retired setup-hub's banners/test-
        notification content (see LegacyDiagnosticsFragment's kdoc) - not a
        Designer-P3 spec, just wired here so the functionality stays
        reachable pending the FRM-103 pass that's meant to design its real
        home. Mirrors advancedRow's link-styled-TextView pattern above
        rather than introducing a new row convention.
    -->
    <TextView
        android:id="@+id/notificationsDiagnosticsRow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/fm_status_healthy"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:text="@string/title_notifications_diagnostics" />

</LinearLayout>
