<?xml version="1.0" encoding="utf-8"?>
<!--
  FRM-165 (ST-2): body of the full-height templates editor, opened from
  Settings' "Templates" value row. FRM-172: the sheet chrome (handle,
  title, 24dp gutter, the Done primary) now comes from FmBottomSheet /
  sheet_fm_base.xml; this layout is only the field, its helper beneath it,
  and the count.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FM.TextInput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="@string/label_templates_field">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/templatesInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:scrollbars="vertical" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fm_space_2"
        android:text="@string/hint_message_templates"
        android:textAppearance="@style/TextAppearance.FM.RowSecondary" />

    <TextView
        android:id="@+id/templatesCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.FM.RowSecondary" />
</LinearLayout>
