<?xml version="1.0" encoding="utf-8"?>
<!--
  FRM-165 (ST-2): full-height editor for the message templates, opened from
  Settings' "Templates" value row. The field fills the sheet (it used to be
  clipped to a few lines inline on Settings) and the helper text sits
  beneath it rather than floating on its border. Same sheet chrome as
  dialog_value_picker.xml (surface, handle, 24dp gutter, one full-width
  primary); FRM-172 will move both onto the shared sheet base.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:paddingStart="@dimen/fm_gutter"
    android:paddingEnd="@dimen/fm_gutter"
    android:paddingBottom="@dimen/fm_space_4">

    <View
        android:layout_width="@dimen/fm_dialog_handle_width"
        android:layout_height="@dimen/fm_dialog_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/fm_dialog_handle_margin_top"
        android:background="@drawable/bg_dialog_drag_handle"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fm_space_4"
        android:text="@string/title_edit_templates"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/fm_heading"
        android:accessibilityHeading="true" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.FM.TextInput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/fm_space_4"
        android:hint="@string/label_templates_field">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/templatesInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:scrollbars="vertical" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fm_space_2"
        android:text="@string/hint_message_templates"
        android:textAppearance="@style/TextAppearance.FM.RowSecondary" />

    <TextView
        android:id="@+id/templatesCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.FM.RowSecondary" />

    <Button
        android:id="@+id/templatesDoneButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="@dimen/fm_space_2"
        android:text="@string/action_done" />
</LinearLayout>
