<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification/diagnostic banners + test-notification preview - all that's
  left of the pre-Phase-3 "setup hub" screen (formerly HomeFragment) after
  FRM-99 retired Dashboard and its toolbar menu. The three navigation
  shortcut rows this screen used to carry (Groups / Edit Friends / Settings)
  are gone: Groups and Settings are reachable directly from the bottom nav
  now (FRM-100), and Edit Friends is superseded by Home's FAB (FRM-99 §1.7).
  Reached only from SettingsFragment's "Notifications & diagnostics" row
  (see fragment_settings.xml / SettingsFragment.kt) - an interim wiring,
  not a Designer-P3 spec, pending the FRM-103 pass this content is queued
  for (SCREENS-PHASE3.md's "Setup hub" capture note).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        GH #132: extended teal header (DESIGN-SYSTEM-PHASE3.md §5), matching
        fragment_overall_history.xml's established pattern - see
        EdgeToEdgeHeader's kdoc.
    -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fm_header">

        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_home_header_height">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/fm_on_primary"
                android:contentDescription="@string/content_desc_back" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="@dimen/fm_space_6"
                android:text="@string/title_notifications_diagnostics"
                android:textColor="@color/fm_on_primary"
                android:textSize="@dimen/fm_header_title_size"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Status banners (Designer spec §3.3) -->
            <TextView
                android:id="@+id/missingContactsBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorErrorContainer"
                android:textColor="?attr/colorOnErrorContainer"
                android:paddingStart="@dimen/fm_gutter"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/fm_gutter"
                android:paddingBottom="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notificationsDisabledBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorErrorContainer"
                android:textColor="?attr/colorOnErrorContainer"
                android:paddingStart="@dimen/fm_gutter"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/fm_gutter"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:text="@string/banner_notifications_disabled" />

            <!-- Empty-friend-list state (Designer spec §4.1) -->
            <LinearLayout
                android:id="@+id/emptyStateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_empty_friend_list"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/addFriendsButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_add_friends" />
            </LinearLayout>

            <!-- Preview + test button (hidden when friend list is empty) -->
            <LinearLayout
                android:id="@+id/previewGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/fm_gutter"
                android:paddingEnd="@dimen/fm_gutter"
                android:paddingTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_preview_header"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_notification_preview"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_preview_chip"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/previewContactName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/notif_body"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/testNotificationButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/action_test_notification" />

                <!--
                    FRM-78: sets expectations before the tap, which is where
                    the "is this a real reminder?" confusion actually starts.
                    Real text, not a contentDescription-only hint, so it's
                    visible to everyone and not just screen-reader users.
                -->
                <TextView
                    android:id="@+id/testNotificationCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/caption_test_notification"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
