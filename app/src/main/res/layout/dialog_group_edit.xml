<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/fm_gutter"
    android:paddingTop="@dimen/fm_space_4"
    android:paddingEnd="@dimen/fm_gutter"
    android:paddingBottom="@dimen/fm_space_4">

    <!-- FRM-120 (FRM-103 §8.1, "One shape for all of them"): dismissal
         is the handle, the scrim and back - nothing else. The old
         closeButton (X) is gone; dialogTitle now takes the full row. -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fm_space_4"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_group_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fm_space_4"
        android:text="@string/label_group_color"
        android:textAppearance="@style/TextAppearance.FM.SectionLabel" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="@dimen/fm_space_2">

        <LinearLayout
            android:id="@+id/colorSwatchContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- FRM-120: the old Cancel text button is gone - the filled
         primary is the only button, per the same spec above. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/fm_space_6">

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
