<?xml version="1.0" encoding="utf-8"?>
<!-- Warm Circle rebrand (DESIGN-SYSTEM-PHASE2.md §5: "disabled = on-surface
     38% opacity"). Label/icon color for a gold/secondary-filled button
     (logOutreachButton, OutreachLogDialog's saveButton). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.38"
        android:color="?attr/colorOnSurface"
        android:state_enabled="false" />
    <item android:color="?attr/colorOnSecondary" />
</selector>
