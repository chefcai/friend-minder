<?xml version="1.0" encoding="utf-8"?>
<!-- FRM-159: segment label and check-icon tint. White on the selected
     fm_primary fill (4.67:1), fm_ink on the unselected white segment; the
     check is transparent there, so it shows on the selected segment only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/fm_on_primary" android:state_checked="true" />
    <item android:color="@color/fm_ink" />
</selector>
