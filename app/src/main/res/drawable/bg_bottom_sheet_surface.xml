<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 3 dialog ground (SCREENS-PHASE3.md §8.1): fm_surface fill, 16dp
     top corners only (a bottom sheet's lower edge is off-screen). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/fm_surface" />
    <corners
        android:topLeftRadius="@dimen/fm_dialog_corner_radius"
        android:topRightRadius="@dimen/fm_dialog_corner_radius"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
