<?xml version="1.0" encoding="utf-8"?>
<!-- Status badge, no-streak state (DESIGN-SYSTEM-PHASE3.md §2.5/§6.5): no
     fill, 2dp fm_primary ring. Stroke is inset (box-sizing: border-box
     equivalent, per §6.5) so this renders at the same 28dp diameter as
     bg_status_badge_filled.xml rather than growing to 32dp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="@dimen/fm_status_badge_ring_width"
        android:color="@color/fm_primary" />
</shape>
