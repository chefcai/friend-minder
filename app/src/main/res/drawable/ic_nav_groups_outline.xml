<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-nav "Groups" glyph, inactive/outline state (DESIGN-SYSTEM-PHASE3.md
     §2/§6, FRM-100). Two overlapping ring circles, stroke only - deliberately
     simple rather than a stroked copy of ic_people.xml's compound silhouette,
     which would trace four overlapping subpath boundaries and read as
     clutter at 28dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5.5,10 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
        android:strokeColor="@color/fm_ink_dim"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />
    <path
        android:pathData="M11.5,10 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
        android:strokeColor="@color/fm_ink_dim"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />
</vector>
