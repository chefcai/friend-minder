<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      FRM-154 (AC-2): the one text-input style, DESIGN-SYSTEM Section 6.3.
      fm_surface_sunken fill, 1dp fm_outline border, 12dp radius, 2dp
      fm_primary border on focus, fm_ink text, fm_ink_dim hint. Also the
      theme's textInputStyle, so a TextInputLayout with no style gets it.

      The floating label, when collapsed onto the border, is teal text on a
      tinted field, so it uses fm_accent (Section 2.4), not fm_primary.
    -->
    <style name="Widget.FM.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/fm_surface_sunken</item>
        <item name="boxStrokeColor">@color/fm_text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/fm_accent</item>
        <item name="android:textColorHint">@color/fm_ink_dim</item>
        <item name="placeholderTextColor">@color/fm_ink_dim</item>
    </style>

    <!--
      FRM-159 (audit CD-4): one segmented-control segment, used by Contact
      Detail's History / Special Dates and Settings' Fixed time / Random
      window. Selected = fm_primary fill, white label and a 16dp check;
      unselected = white with an fm_ink label; 1dp fm_outline border.
      The selection is carried by fill contrast (4.67:1) and by the check,
      not by a tint alone.
    -->
    <style name="Widget.FM.SegmentedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/fm_segment_background</item>
        <item name="android:textColor">@color/fm_segment_label</item>
        <item name="strokeColor">@color/fm_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="icon">@drawable/ic_check_small</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/fm_segment_icon</item>
        <item name="rippleColor">@color/fm_primary</item>
        <!-- FRM-160 (audit CD-8): the segment grows with its label
             (wrap_content height, 48dp minimum). At large text sizes the
             control stacks vertically at full width whenever a label would
             be cut off - see ui/common/SegmentedControls.kt. -->
        <item name="android:minHeight">48dp</item>
    </style>

    <!--
      FRM-160 (audit CD-8): the caption under each Contact Detail figure
      ("outreaches", "day streak", "reach rate"). At 200% text a single
      word no longer fits a third of the screen and was split mid-word
      ("outreache / s"). Now: one line, centred, shrinking down to 9sp so the
      whole caption fits its column; words are never split (simple break
      strategy, no hyphenation). Measured on device: allowing two lines let
      autosize accept a mid-word break instead of shrinking.
    -->
    <style name="Widget.FM.StatLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/fm_ink_dim</item>
        <item name="android:gravity">center_horizontal|top</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:breakStrategy">simple</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">13sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
