<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 2 spacing/component tokens (FRM-42), Designer's Confluence
  "Phase 2 UI Specs" §3. The 4dp base grid plus the specific component
  measurements called out for avatars, cards, badges and the outreach FAB -
  used as new screens (FRM-42-44) come online, and already applied to the
  existing contact list rows (avatar size, row spacing) - originally
  item_contact.xml, now item_add_contact_candidate.xml/item_home_contact.xml
  (item_contact.xml itself retired on FRM-102).
-->
<resources>
    <!-- 4dp base grid -->
    <dimen name="fm_space_1">4dp</dimen>
    <dimen name="fm_space_2">8dp</dimen>
    <dimen name="fm_space_3">12dp</dimen>
    <dimen name="fm_space_4">16dp</dimen>
    <dimen name="fm_space_6">24dp</dimen>
    <dimen name="fm_space_8">32dp</dimen>

    <!-- Cards -->
    <dimen name="fm_card_corner_radius">12dp</dimen>
    <dimen name="fm_card_elevation">4dp</dimen>
    <dimen name="fm_card_elevation_pressed">8dp</dimen>
    <dimen name="fm_card_padding">16dp</dimen>

    <!-- Avatars (FRM-39): circular photo or initials-fallback size by context -->
    <dimen name="fm_avatar_size_list">48dp</dimen>
    <dimen name="fm_avatar_size_detail">96dp</dimen>
    <dimen name="fm_avatar_size_notification">64dp</dimen>
    <dimen name="fm_avatar_outline_width">1dp</dimen>

    <!-- Streak badge + Log Outreach FAB -->
    <dimen name="fm_streak_badge_size">24dp</dimen>
    <dimen name="fm_fab_size">56dp</dimen>

    <!-- Phase 3 (FRM-98/99/100): DESIGN-SYSTEM-PHASE3.md §4. -->
    <!-- GH #166: the one side gutter every screen's content column should
         share (§4.1). Home already honoured this at 24dp (fm_space_6);
         Groups/Group Detail/Contact Detail/Settings were still at 16dp -
         a per-layout literal each, not a shared token, which is exactly
         how they drifted. Referenced everywhere the leading/trailing edge
         of a screen's content sits against the screen edge; NOT a general
         substitute for fm_space_4/fm_space_6 elsewhere (card padding,
         dialog padding, inter-element spacing are unrelated concerns). -->
    <dimen name="fm_gutter">24dp</dimen>
    <dimen name="fm_home_header_height">72dp</dimen>
    <dimen name="fm_home_row_height">76dp</dimen>
    <dimen name="fm_status_badge_size">28dp</dimen>
    <dimen name="fm_status_badge_ring_width">2dp</dimen>
    <dimen name="fm_home_list_bottom_padding">88dp</dimen>
    <dimen name="fm_bottom_nav_height">64dp</dimen>
    <!-- FRM-115: default M3 unlabeled item icon is 24dp; spec wants 28dp
         centred in a 48dp touch target. -->
    <dimen name="fm_bottom_nav_icon_size">28dp</dimen>
    <dimen name="fm_header_title_size">30sp</dimen>

    <!-- Phase 3 dialog chrome (SCREENS-PHASE3.md §8.1), introduced with
         FRM-102's two rebuilt dialogs - FRM-103's dialog pass should reuse
         these rather than re-deriving them per screen. -->
    <dimen name="fm_dialog_corner_radius">16dp</dimen>
    <dimen name="fm_dialog_handle_width">32dp</dimen>
    <dimen name="fm_dialog_handle_height">4dp</dimen>
    <dimen name="fm_dialog_handle_margin_top">12dp</dimen>

    <!-- Bulk removal selection mode (FRM-112, SCREENS-PHASE3.md §10.3):
         header title's start margin when the leading ✕ is shown, matching
         the same 72dp value fragment_overall_history.xml's back-arrow case
         hardcodes inline - this one's a dimen (not inline) because
         HomeFragment toggles it at runtime rather than fixing it in XML. -->
    <dimen name="fm_header_title_margin_with_leading_icon">72dp</dimen>

    <!-- FRM-164: leading icon on the Settings next-reminder line. -->
    <dimen name="fm_status_icon_size">16dp</dimen>
    <dimen name="fm_status_icon_gap">4dp</dimen>
    <!-- FRM-166: widest a settings value may get before it wraps. -->
    <dimen name="fm_value_row_value_max_width">180dp</dimen>
    <!-- FRM-174 (DL-2): group swatch grid. The cell is the 48dp swatch plus a
         3dp gap and a 2dp ring on each side (58dp), so the selected ring
         sits outside the swatch; cell margins are the 24dp / 16dp swatch
         spacing minus that 5dp. -->
    <dimen name="fm_swatch_size">48dp</dimen>
    <dimen name="fm_swatch_ring_width">2dp</dimen>
    <dimen name="fm_swatch_ring_gap">3dp</dimen>
    <dimen name="fm_swatch_cell">58dp</dimen>
    <dimen name="fm_swatch_cell_gap_h">14dp</dimen>
    <dimen name="fm_swatch_cell_gap_v">6dp</dimen>
</resources>
