<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
        FRM-79 (GH #90): icons are unchanged, only their destinations moved.
        action_manage now goes straight to Edit Friends (skipping the setup
        hub); action_setup (formerly action_advanced_settings, and formerly
        a direct link to AdvancedSettingsFragment) now opens the setup hub
        (HomeFragment) instead - the gear stays, repurposed as the way into
        the hub rather than a shortcut past it. Advanced itself moved onto
        SettingsFragment; see SettingsFragment's advancedRow.
    -->
    <item
        android:id="@+id/action_manage"
        android:icon="@drawable/ic_people"
        android:title="@string/action_manage_menu"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_setup"
        android:icon="@drawable/ic_settings"
        android:title="@string/action_setup"
        app:showAsAction="always" />

</menu>
