<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read the phone's contact list so the user can build their Friend List -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- PRD §16 Q1 (LOCKED: "Request SEND_SMS"). Requested at runtime by
         SmsLaunchActivity as of chefcai/friend-minder#29: reminders now send
         directly when the user grants this permission, falling back to
         ACTION_SENDTO (open the user's own SMS app, pre-filled) if they
         deny it or no message body is set — matching the PRD's "otherwise,
         require manual send confirmation" branch of the same decision. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- SEND_SMS above implies telephony hardware is required by default (this trips
         ChromeOS/tablet installability). The app degrades gracefully to the
         ACTION_SENDTO fallback when SEND_SMS is denied or unusable (see
         SmsLaunchActivity), so declare telephony optional rather than required
         (FRM-18 / PermissionImpliesUnsupportedChromeOsHardware). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Deliver the daily reminder notification (required at runtime on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WorkManager reschedules pending work after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FriendMinderApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FriendMinder">

        <!-- GH #153: without an explicit windowSoftInputMode, the keyboard's
             behavior on a single-activity/many-fragments app like this one
             is effectively unspecified per-screen - confirmed via
             uiautomator that a focused EditText's containing window never
             resized at all when the keyboard opened, so the keyboard just
             drew over whatever was focused. adjustResize is the fix for
             every screen that keeps the platform's normal
             decorFitsSystemWindows(true) behavior; the handful of screens
             that opt into edge-to-edge (EdgeToEdgeHeader.
             applyEdgeToEdgeHeader) turn that off for themselves and are
             responsible for consuming the IME inset manually (see
             ImeInsetPadding) - adjustResize is still the right mode for
             them too, since it's what makes WindowInsetsCompat report a
             nonzero ime() inset once they've opted out of the automatic
             resize. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FriendMinder.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trampoline the reminder notification's PendingIntent targets to
             send/open the SMS composer (see SmsLaunchActivity). Translucent
             rather than Theme.NoDisplay (chefcai/friend-minder#29): the
             activity now has to stay alive across an async runtime
             permission request/response, which a NoDisplay-themed activity
             cannot do without risking a BadTokenException — translucent
             lets it linger invisibly until it finishes itself. Not
             exported: only ever invoked via a PendingIntent this app created. -->
        <activity
            android:name=".notifications.SmsLaunchActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- FRM-186: the Call counterpart, used when the notified contact's stored
             preference (FRM-183) is Call. Same trampoline shape as SmsLaunchActivity
             above - not exported, only ever invoked via a PendingIntent this app created. -->
        <activity
            android:name=".notifications.CallLaunchActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

    </application>

</manifest>
