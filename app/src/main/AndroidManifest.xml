<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read the phone's contact list so the user can build their Friend List -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Declared per PRD §16 Q1 ("LOCKED: Request SEND_SMS"); NOT requested at
         runtime by this implementation — Designer spec §2.3/§3.4 and the
         README both specify launching the SMS app via ACTION_SENDTO (the
         user reviews/sends in their own SMS app), which doesn't require this
         permission. Left declared rather than silently dropped since it was
         an explicit PRD decision; flagged in FRM-5 status notes for
         Tracker/PM to confirm it can be removed. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- SEND_SMS above implies telephony hardware is required by default (this trips
         ChromeOS/tablet installability). The app never actually places calls or sends
         SMS itself (see comment above - it only launches the user's SMS app), so declare
         telephony optional rather than required (FRM-18 / PermissionImpliesUnsupportedChromeOsHardware). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Deliver the daily reminder notification (required at runtime on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WorkManager reschedules pending work after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FriendMinderApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FriendMinder">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent trampoline the reminder notification's PendingIntent
             targets to open the SMS composer (see SmsLaunchActivity). Not
             exported: only ever invoked via a PendingIntent this app created. -->
        <activity
            android:name=".notifications.SmsLaunchActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true" />

    </application>

</manifest>
